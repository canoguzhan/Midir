# /etc/caddy/Caddyfile — BroadGamesPro preview site, password protected (HTTP Basic Auth, user: broadgames).
# The real file holds the bcrypt hash; generate one with: caddy hash-password --plaintext '<password>'
(protected) {
	basicauth {
		broadgames <bcrypt-hash>
	}
	encode gzip
	reverse_proxy 127.0.0.1:8080
}

broadgames.pro, 104-207-80-220.sslip.io {
	# online game rooms (mp/whirlbash.mjs) must be reachable without the password: CrazyGames players connect here
	handle /mp/* {
		reverse_proxy 127.0.0.1:8090
	}
	# press kits (covers, key art, screenshots, preview videos, press release) are public: stores and press link to them
	@presskit path_regexp ^/releases/[a-z0-9-]+/presskit/
	handle @presskit {
		encode gzip
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		import protected
	}
}

www.broadgames.pro {
	redir https://broadgames.pro{uri} permanent
}
